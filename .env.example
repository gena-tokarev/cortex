POSTGRES_USER=focoris
POSTGRES_PASSWORD=focoris
POSTGRES_DB=focoris_auth
POSTGRES_PORT=5432
REDIS_PORT=6379

AUTH_API_PORT=3001
AUTH_DATABASE_URL=postgresql://focoris:focoris@postgres:5432/focoris_auth?schema=public
AUTH_REDIS_URL=redis://redis:6379
AUTH_ACCESS_TOKEN_SECRET=replace-with-strong-access-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_GOOGLE_CLIENT_ID=google-client-id
AUTH_GOOGLE_CLIENT_SECRET=google-client-secret
AUTH_GOOGLE_CALLBACK_URL=http://localhost:3001/api/external-auth/google/callback
AUTH_PASSKEY_RP_ID=localhost
AUTH_PASSKEY_RP_NAME=Focoris Auth
AUTH_PASSKEY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_PORT=3000
