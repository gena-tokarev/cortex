POSTGRES_USER=cortex
POSTGRES_PASSWORD=cortex
POSTGRES_DB=cortex_auth
POSTGRES_PORT=5432
REDIS_PORT=6379

AUTH_API_PORT=3001
DATABASE_URL=postgresql://cortex:cortex@localhost:5432/cortex_auth?schema=public
REDIS_URL=redis://localhost:6379
AUTH_ACCESS_TOKEN_SECRET=replace-with-strong-access-secret
AUTH_REFRESH_TOKEN_SECRET=replace-with-strong-refresh-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/external-auth/google/callback
GOOGLE_ALLOWED_WEB_REDIRECT_URIS=http://localhost:3000
GOOGLE_ALLOWED_NATIVE_REDIRECT_URIS=cortex://auth/callback
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Cortex Auth
PASSKEY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
WEB_PORT=3000
WEB_APP_ORIGIN=http://localhost:3000
AUTH_API_URL=http://localhost:3001
