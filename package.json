{
  "name": "@cortex/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "bun@1.2.19",
  "scripts": {
    "build": "turbo run build",
    "build:auth-api": "turbo run build --filter=@cortex/auth-api",
    "build:web": "turbo run build --filter=@cortex/web",
    "dev": "turbo run dev --parallel",
    "dev:auth-api": "turbo run dev --filter=@cortex/auth-api",
    "dev:web": "turbo run dev --filter=@cortex/web",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:auth-api": "turbo run test --filter=@cortex/auth-api",
    "e2e": "turbo run e2e",
    "e2e:auth-api": "turbo run e2e --filter=@cortex/auth-api-e2e",
    "db:generate": "turbo run db:generate --filter=@cortex/auth-api",
    "db:migrate": "turbo run db:migrate --filter=@cortex/auth-api",
    "db:seed": "turbo run db:seed --filter=@cortex/auth-api"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "^0.7.8",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.19.12",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.2",
    "jest-environment-node": "^30.0.2",
    "jest-util": "^30.0.2",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "postcss": "^8.5.15",
    "prettier": "^2.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.3",
    "turbo": "^2.5.8",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "source-map-support": "^0.5.21"
  }
}
