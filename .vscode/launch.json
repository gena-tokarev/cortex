{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug auth-api",
      "cwd": "${workspaceFolder}/apps/auth-api",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "dev:debug"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "PORT": "3001"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug web",
      "cwd": "${workspaceFolder}/apps/web",
      "runtimeExecutable": "node",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev", "--port", "3000"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Debug auth-api + web",
      "configurations": ["Debug auth-api", "Debug web"]
    }
  ]
}
