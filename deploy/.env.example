POSTGRES_USER=focoris
POSTGRES_PASSWORD=replace-with-existing-postgres-password
POSTGRES_DB=focoris_auth
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://redis:6379

AUTH_API_PORT=3001
# URL-encode POSTGRES_PASSWORD when using it in DATABASE_URL.
DATABASE_URL=postgresql://focoris:replace-with-url-encoded-password@postgres:5432/focoris_auth?schema=public

AUTH_ACCESS_TOKEN_SECRET=replace-with-a-strong-random-value
AUTH_REFRESH_TOKEN_SECRET=replace-with-a-different-strong-random-value
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800

AUTH_COOKIE_ACCESS_TOKEN_NAME=focoris_access_token
AUTH_COOKIE_REFRESH_TOKEN_NAME=focoris_refresh_token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

AUTH_EXTERNAL_AUTH_CODE_TTL_SECONDS=300
AUTH_EXTERNAL_AUTH_STATE_SECRET=replace-with-another-strong-random-value

GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=https://focoris-dev.podolog-warsaw.pl/api/external-auth/google/callback
GOOGLE_ALLOWED_WEB_REDIRECT_URIS=https://focoris-dev.podolog-warsaw.pl
GOOGLE_ALLOWED_NATIVE_REDIRECT_URIS=focoris://auth/callback

PASSKEY_RP_ID=focoris-dev.podolog-warsaw.pl
PASSKEY_RP_NAME=Focoris
PASSKEY_ALLOWED_ORIGINS=https://focoris-dev.podolog-warsaw.pl

WEB_PORT=3000
WEB_APP_ORIGIN=https://focoris-dev.podolog-warsaw.pl
AUTH_API_URL=http://auth-api:3001
